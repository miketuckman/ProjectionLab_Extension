{
  "manifest_version": 3,
  "name": "ProjectionLab MCP Bridge (Chrysalis)",
  "version": "1.1.0",
  "key": "",
  "description": "Preview and approve snapshot-backed Monarch balance updates to ProjectionLab through a local MCP server.",
  "permissions": ["storage", "scripting", "tabs", "nativeMessaging"],
  "host_permissions": [
    "https://app.monarch.com/*",
    "https://api.monarch.com/*",
    "https://api.monarchmoney.com/*",
    "https://app.projectionlab.com/*",
    "https://ea.projectionlab.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://app.monarch.com/*"],
      "js": ["content-scripts/monarch.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "setup/setup.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
